# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trgovacki?schema=public"

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-in-production-minimum-32-characters-long-secret"
SESSION_TTL_HOURS="12"

# --- Application ----------------------------------------------------------
APP_URL="http://localhost:3000"
DEFAULT_LOCALE="hr"
DEFAULT_CURRENCY="EUR"

# --- Fiscalization (Croatia) ---------------------------------------------
# Adapter: none | hr-demo | hr-production
FISCAL_ADAPTER="none"
FISCAL_CERT_PATH=""
FISCAL_CERT_PASSWORD=""
FISCAL_ENDPOINT="https://cistest.apis-it.hr:8449/FiskalizacijaServiceTest"
