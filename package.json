{
  "name": "trgovacki",
  "version": "1.0.0",
  "private": true,
  "description": "Trgovacki - Enterprise Retail Management Platform (POS + Back Office)",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "postinstall": "prisma generate",
    "doctor": "node scripts/doctor.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "serve": "npm run build && npm run start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "test": "tsx --conditions=react-server --test \"tests/**/*.test.ts\"",
    "test:unit": "tsx --conditions=react-server --test tests/money.test.ts tests/pricing-math.test.ts tests/promotions.test.ts",
    "e2e": "node scripts/e2e.mjs",
    "manual": "node scripts/build-manual.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@tanstack/react-query": "^5.62.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^18.0.2",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "prisma": "^6.1.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
